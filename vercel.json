{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|LinkedInBot|Twitterbot|TelegramBot|WhatsApp|Slackbot|Discordbot|SkypeUriPreview|googlebot|bingbot|facebookcatalog|vkShare).*|.*bot.*|.*crawler.*|.*spider.*"
        }
      ],
      "destination": "/api/og?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
